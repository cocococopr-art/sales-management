# Google Sheets API設定
# 1. https://console.cloud.google.com/ でプロジェクト作成
# 2. Google Sheets API を有効化
# 3. APIキー発行（サービスアカウント不要・読み取りのみならAPIキーだけでOK）
# 4. スプレッドシートを「リンクを知っている人が閲覧可能」に設定

VITE_SHEET_ID=your_google_sheet_id_here
VITE_SHEETS_API_KEY=your_api_key_here

# Google Apps Script（書き込み用）
# GASデプロイ後のWeb App URLを設定
VITE_GAS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
